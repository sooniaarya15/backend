# Server
PORT=5000

# Supabase Postgres connection string
# Find this in: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed credentials (used once by db/seedAdmin.js)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Email (for contact form) - optional for Day 1, needed by Day 11
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# CORS - the URL(s) of your frontend + admin panel, comma separated
CLIENT_URLS=http://localhost:3000,http://localhost:5173